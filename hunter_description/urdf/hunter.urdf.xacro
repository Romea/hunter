<?xml version='1.0' encoding='utf-8'?>
<robot name="hunter" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="prefix" default="hunter_" />
  <xacro:arg name="mode" default="simulation" />
  <xacro:arg name="base_name" default="base" />
  <xacro:arg name="ros2_control_config_urdf_file" default="" />
  <xacro:arg name="controller_manager_config_yaml_file" default="" />
  <xacro:arg name="ros_prefix" default="/hunter/" />

  <xacro:include filename="$(find hunter_description)/urdf/hunter.xacro" />
  <xacro:hunter mode="$(arg mode)" prefix="$(arg prefix)" />

  <xacro:include filename="$(find hunter_description)/urdf/hunter.simulation.xacro" />

  <xacro:hunter_simulation
    mode="$(arg mode)"
    base_name="$(arg base_name)"
    ros_prefix="$(arg ros_prefix)"
    controller_manager_config_yaml_file="$(arg controller_manager_config_yaml_file)" />

</robot>