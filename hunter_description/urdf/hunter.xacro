<?xml version="1.0"?>
<robot name="hunter" xmlns:xacro="http://www.ros.org/wiki/xacro">

   <xacro:macro name="hunter" params="mode prefix">

      <xacro:include filename="$(find romea_mobile_base_description)/urdf/base1FASxxx.chassis.xacro" />
      <xacro:include filename="$(find hunter_description)/urdf/visual/chassis.xacro" />
      <xacro:include filename="$(find hunter_description)/urdf/visual/wheels.xacro" />
      <xacro:include filename="$(find hunter_description)/urdf/visual/arms.xacro" />

      <xacro:property name="conf" value="$(find hunter_description)/config/hunter.yaml" />
      <xacro:include filename="$(find hunter_description)/urdf/hunter_properties.xacro" />

      <xacro:chassis>
         <chassis_visuals>
           <xacro:chassis_visual />
         </chassis_visuals>
         <xacro:front_left_arm_visual />
         <xacro:front_right_arm_visual />
         <xacro:front_left_wheel_visual />
         <xacro:front_right_wheel_visual />
         <xacro:rear_left_wheel_visual />
         <xacro:rear_right_wheel_visual />
      </xacro:chassis>

   </xacro:macro>

</robot>